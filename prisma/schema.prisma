generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  HEADQUARTERS
  OWNER
}

enum SchoolStatus {
  ACTIVE
  PAUSED
  ARCHIVED
}

enum QuestionType {
  SINGLE_CHOICE
  MULTIPLE_CHOICE
  RATING
  FREE_TEXT
}

enum ReviewSource {
  SURVEY
  GOOGLE
  MANUAL
}

enum ReviewStatus {
  DRAFT
  GENERATED
  PENDING
  PENDING_CUSTOM_REPLY
  APPROVED
  REVISED
  REVISED_AND_REPLIED
  MANUAL
  COPIED
  POSTED
  REPLIED
  ARCHIVED
}

enum KeywordRankDevice {
  DESKTOP
  MOBILE
}

model User {
  id             String    @id @default(cuid())
  name           String?
  email          String?   @unique
  emailVerified  DateTime?
  image          String?
  role           Role      @default(OWNER)
  passwordHash   String?
  lineUserId     String?   @unique
  lastSignedInAt DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  ownedSchools School[]     @relation("SchoolOwner")
  memberships  UserSchool[]
  accounts     Account[]
  sessions     Session[]
  reviews      Review[]     @relation("ReviewAuthor")

  @@index([role])
  @@index([createdAt])
}

model UserSchool {
  id        String   @id @default(cuid())
  userId    String
  schoolId  String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  school School @relation(fields: [schoolId], references: [id], onDelete: Cascade)

  @@unique([userId, schoolId])
  @@index([schoolId])
}

model Account {
  id                String   @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?  @db.Text
  access_token      String?  @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?  @db.Text
  session_state     String?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@index([userId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expires])
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model School {
  id              String       @id @default(cuid())
  ownerId         String
  name            String
  brandName       String?
  status          SchoolStatus @default(ACTIVE)
  postalCode      String?
  prefecture      String?
  city            String?
  addressLine     String?
  phoneNumber     String?
  websiteUrl      String?
  googlePlaceId   String       @unique
  googleMapsUrl   String?
  gbpAccountId    String?
  gbpLocationId   String?
  instagramUserId String?
  lineChannelId   String?
  aiSearchPrompt  String?
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt

  owner             User              @relation("SchoolOwner", fields: [ownerId], references: [id], onDelete: Cascade)
  memberships       UserSchool[]
  surveySettings    SurveySetting[]
  surveys           Survey[]
  reviews           Review[]
  keywordRanks      KeywordRank[]
  gbpMetrics        GbpMetric[]
  instagramSetting  InstagramSetting?
  schoolSetting     SchoolSetting?
  syncedPosts       SyncedPost[]
  targetKeywords    TargetKeyword[]
  aioScoreHistories AioScoreHistory[]

  @@index([ownerId])
  @@index([status])
  @@index([prefecture, city])
  @@index([createdAt])
}

model SurveySetting {
  id          String       @id @default(cuid())
  schoolId    String
  title       String
  description String?
  question    String
  type        QuestionType
  options     Json?
  isRequired  Boolean      @default(false)
  sortOrder   Int          @default(0)
  isActive    Boolean      @default(true)
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  school School @relation(fields: [schoolId], references: [id], onDelete: Cascade)

  @@index([schoolId, isActive, sortOrder])
  @@index([type])
}

model Survey {
  id                String   @id @default(cuid())
  schoolId          String
  title             String
  requiredKeywords  String?
  minCharCount      Int      @default(100)
  maxCharCount      Int      @default(300)
  isValid           Boolean  @default(true)
  benefitType       String?
  benefitShowTiming String?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  school School       @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  items  SurveyItem[]

  @@index([schoolId, isValid])
  @@index([createdAt])
}

model SurveyItem {
  id          String   @id @default(cuid())
  surveyId    String
  type        String
  question    String
  maxSelect   Int?
  options     String[]
  placeholder String?
  order       Int
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  survey Survey @relation(fields: [surveyId], references: [id], onDelete: Cascade)

  @@index([surveyId, order])
}

model SchoolSetting {
  id                     String   @id @default(cuid())
  schoolId               String   @unique
  googleConnected        Boolean  @default(false)
  googleAccountId        String?
  googleRefreshToken     String?
  selectedGbpLocationId  String?
  googleReviewUrl        String?
  lineNotifyEnabled      Boolean  @default(true)
  lineChannelAccessToken String?
  lineDestinationId      String?
  notifyOnNewReview      Boolean  @default(true)
  notifyOnLowRating      Boolean  @default(true)
  instagramConnected     Boolean  @default(false)
  instagramMetaAppId     String?
  instagramMetaAppSecret String?
  promptSystemRole       String?  @db.Text
  promptReviewTone       String   @default("FRIENDLY")
  promptForbiddenWords   String[]
  promptMustKeywords     String[]
  createdAt              DateTime @default(now())
  updatedAt              DateTime @updatedAt

  school School @relation(fields: [schoolId], references: [id], onDelete: Cascade)

  @@index([googleConnected])
  @@index([lineNotifyEnabled])
  @@index([instagramConnected])
}

model Review {
  id                 String       @id @default(cuid())
  schoolId           String
  authorId           String?
  source             ReviewSource @default(SURVEY)
  status             ReviewStatus @default(DRAFT)
  parentName         String?
  studentGrade       String?
  rating             Int?
  surveyAnswers      Json?
  originalText       String?
  comment            String?      @db.Text
  generatedPatterns  Json?
  selectedReviewText String?
  googleReviewId     String?
  gbpReviewId        String?
  authorName         String?
  aiReplyText        String?
  aiReplyDraft       String?      @db.Text
  pendingCustomReply String?      @db.Text
  replyText          String?      @db.Text
  lineUserId         String?
  aiReplyGeneratedAt DateTime?
  copiedAt           DateTime?
  postedAt           DateTime?
  repliedAt          DateTime?
  createdAt          DateTime     @default(now())
  updatedAt          DateTime     @updatedAt

  school School @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  author User?  @relation("ReviewAuthor", fields: [authorId], references: [id], onDelete: SetNull)

  @@index([schoolId, status])
  @@index([schoolId, source])
  @@index([schoolId, postedAt])
  @@index([authorId])
  @@index([gbpReviewId])
  @@index([lineUserId, status])
  @@index([rating])
  @@index([createdAt])
}

model KeywordRank {
  id             String            @id @default(cuid())
  schoolId       String
  keyword        String
  searchArea     String
  rank           Int?
  previousRank   Int?
  device         KeywordRankDevice @default(MOBILE)
  measuredAt     DateTime          @default(now())
  competitorData Json?
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt

  school School @relation(fields: [schoolId], references: [id], onDelete: Cascade)

  @@unique([schoolId, keyword, searchArea, device, measuredAt])
  @@index([schoolId, keyword, measuredAt])
  @@index([schoolId, searchArea])
  @@index([rank])
  @@index([measuredAt])
}

model GbpMetric {
  id            String   @id @default(cuid())
  schoolId      String
  date          DateTime @db.Date
  views         Int      @default(0)
  searches      Int      @default(0)
  websiteClicks Int      @default(0)
  phoneCalls    Int      @default(0)
  routeRequests Int      @default(0)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  school School @relation(fields: [schoolId], references: [id], onDelete: Cascade)

  @@unique([schoolId, date])
  @@index([schoolId, date])
  @@index([date])
}

model InstagramSetting {
  id                         String    @id @default(cuid())
  schoolId                   String    @unique
  metaAppId                  String?
  metaAppSecret              String?
  instagramAccessToken       String
  instagramBusinessAccountId String
  autoSyncEnabled            Boolean   @default(false)
  lastSyncedAt               DateTime?
  createdAt                  DateTime  @default(now())
  updatedAt                  DateTime  @updatedAt

  school School @relation(fields: [schoolId], references: [id], onDelete: Cascade)

  @@index([autoSyncEnabled])
  @@index([lastSyncedAt])
}

model SyncedPost {
  id               String   @id @default(cuid())
  schoolId         String
  instagramMediaId String
  gbpPostId        String
  instagramUrl     String?
  gbpPostUrl       String?
  caption          String?
  formattedText    String?
  syncedAt         DateTime @default(now())
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  school School @relation(fields: [schoolId], references: [id], onDelete: Cascade)

  @@unique([schoolId, instagramMediaId])
  @@index([schoolId, syncedAt])
  @@index([gbpPostId])
}

model TargetKeyword {
  id             String   @id @default(cuid())
  schoolId       String
  keyword        String
  location       String
  nearestStation String
  municipality   String
  latitude       Decimal? @db.Decimal(9, 6)
  longitude      Decimal? @db.Decimal(9, 6)
  radiusMeters   Int      @default(1500)
  isActive       Boolean  @default(true)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  school            School            @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  rankHistories     RankHistory[]
  aioScoreHistories AioScoreHistory[]

  @@unique([schoolId, keyword, location])
  @@index([schoolId, isActive])
  @@index([nearestStation])
  @@index([municipality])
}

model RankHistory {
  id             String   @id @default(cuid())
  keywordId      String
  rank           Int?
  competitorData Json?
  checkedAt      DateTime @default(now())
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  keyword TargetKeyword @relation(fields: [keywordId], references: [id], onDelete: Cascade)

  @@index([keywordId, checkedAt])
  @@index([rank])
}

model AioScoreHistory {
  id            String   @id @default(cuid())
  schoolId      String
  keywordId     String
  chatgptScore  Int      @default(0)
  geminiScore   Int      @default(0)
  googleAiScore Int      @default(0)
  totalScore    Int      @default(0)
  aiMentions    Json
  checkedAt     DateTime @default(now())
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  school  School        @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  keyword TargetKeyword @relation(fields: [keywordId], references: [id], onDelete: Cascade)

  @@index([schoolId, checkedAt])
  @@index([keywordId, checkedAt])
  @@index([totalScore])
}
